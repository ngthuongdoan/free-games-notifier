+const fs = require("fs");
+const path = require("path");
+
+/**
+ * Reads and parses the email lists JSON file.
+ *
+ * @returns {Object} an object mapping list names to arrays of addresses
+ */
+function getEmailLists() {
+  const filePath = path.join(__dirname, "data", "email-lists.json");
+  const raw = fs.readFileSync(filePath, "utf8");
+  return JSON.parse(raw);
+}
+
+/**
+ * Returns the list of recipients for the given list name.
+ *
+ * @param {string} listName Name of the email list to retrieve.
+ * @returns {string[]} array of email addresses
+ * @throws {Error} if the list is undefined or empty
+ */
+function getRecipientsByListName(listName) {
+  const lists = getEmailLists();
+  const recipients = lists[listName];
+  if (!Array.isArray(recipients) || recipients.length === 0) {
+    throw new Error(`Email list "${listName}" has no recipients`);
+  }
+  return recipients;
+}
+
+module.exports = {
+  getEmailLists,
+  getRecipientsByListName,
+};
