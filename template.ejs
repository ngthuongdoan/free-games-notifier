<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Games Update</title>
</head>
<body style="margin:0;padding:0;background-color:#0b1020;font-family:Arial,Helvetica,sans-serif;color:#ffffff;">
  <%
    const freeGames = [...(epicGames || []), ...(steamGames || [])];
    const deals = steamDiscountGames || [];
    const safeCheckedAt = checkedAt || new Date().toLocaleDateString();

    const safeFormatDate = typeof formatDate === "function"
      ? formatDate
      : (value) => value || "Unknown";

    const safeFormatPrice = typeof formatPrice === "function"
      ? formatPrice
      : (game) => `${game.originalPrice || "Unknown"} → ${game.discountPrice || "Free"}`;

    const safeFormatVnd = typeof formatVnd === "function"
      ? formatVnd
      : (value) => `${value} VND`;

    function renderCard(game, description, buttonText) {
      const cardPrice = safeFormatPrice(game);
      const cardEnds = safeFormatDate(game.endDate);
      const cardDiscount = game.discountPercent
        ? `${game.discountPercent}% off`
        : game.kind === "free"
          ? "Free now"
          : "Available";
  %>
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom:20px;background:#ffffff;border:1px solid #dbe4ff;border-radius:18px;overflow:hidden;box-shadow:0 8px 24px rgba(15,23,42,0.12);">
      <tr>
        <td valign="top">
          <% if (game.image) { %>
            <img
              src="<%= game.image %>"
              alt="<%= game.title %>"
              width="100%"
              style="display:block;width:100%;height:224px;object-fit:cover;border:0;"
            />
          <% } %>

          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="padding:18px 18px 20px;">
            <tr>
              <td>
                <div style="font-size:14px;line-height:20px;color:#6b7280;margin-bottom:6px;">
                  <%= cardPrice %>
                </div>

                <div style="font-size:24px;line-height:32px;font-weight:700;color:#111827;margin-bottom:10px;">
                  <%= game.title %>
                </div>

                <div style="font-size:15px;line-height:24px;color:#4b5563;margin-bottom:22px;">
                  <%= description %>
                </div>

                <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                  <tr>
                    <td width="33.33%" valign="top" style="padding-right:8px;">
                      <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:12px;min-height:74px;">
                        <div style="font-size:18px;line-height:18px;color:#4338ca;margin-bottom:8px;">🏬</div>
                        <div style="font-size:12px;line-height:18px;color:#6b7280;">Store</div>
                        <div style="font-size:14px;line-height:20px;font-weight:700;color:#111827;"><%= game.store %></div>
                      </div>
                    </td>

                    <td width="33.33%" valign="top" style="padding-left:4px;padding-right:4px;">
                      <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:12px;min-height:74px;">
                        <div style="font-size:18px;line-height:18px;color:#4338ca;margin-bottom:8px;">🏷️</div>
                        <div style="font-size:12px;line-height:18px;color:#6b7280;">Discount</div>
                        <div style="font-size:14px;line-height:20px;font-weight:700;color:#111827;"><%= cardDiscount %></div>
                      </div>
                    </td>

                    <td width="33.33%" valign="top" style="padding-left:8px;">
                      <div style="background:#f8fafc;border:1px solid #e5e7eb;border-radius:12px;padding:12px;min-height:74px;">
                        <div style="font-size:18px;line-height:18px;color:#4338ca;margin-bottom:8px;">⏰</div>
                        <div style="font-size:12px;line-height:18px;color:#6b7280;">Ends</div>
                        <div style="font-size:14px;line-height:20px;font-weight:700;color:#111827;"><%= cardEnds %></div>
                      </div>
                    </td>
                  </tr>
                </table>

                <div style="margin-top:18px;">
                  <a
                    href="<%= game.url %>"
                    style="display:inline-block;background:#312e81;color:#ffffff;text-decoration:none;font-weight:700;padding:12px 18px;border-radius:12px;font-size:14px;"
                  >
                    <%= buttonText %>
                  </a>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  <%
    }
  %>

  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#0b1020;padding:24px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="640" cellspacing="0" cellpadding="0" border="0" style="max-width:640px;background:#121a2f;border-radius:20px;overflow:hidden;border:1px solid #233054;">

          <tr>
            <td style="background:linear-gradient(135deg,#6d28d9,#2563eb,#06b6d4);padding:40px 32px;text-align:center;">
              <div style="font-size:14px;letter-spacing:3px;font-weight:bold;text-transform:uppercase;color:#dbeafe;">
                DAILY GAME DROP
              </div>

              <h1 style="margin:16px 0 10px;font-size:36px;line-height:42px;color:#ffffff;">
                🎮 Free Games & Steam Deals
              </h1>

              <p style="margin:0;font-size:16px;line-height:26px;color:#e0f2fe;">
                Free games plus Steam discounts under <%= safeFormatVnd(steamMaxPriceVnd || 200000) %>.
              </p>
            </td>
          </tr>

          <tr>
            <td style="padding:28px 32px 12px;">
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  <td width="33.33%" style="padding:8px;">
                    <div style="background:#19233f;border:1px solid #2b3a63;border-radius:14px;padding:18px;text-align:center;">
                      <div style="font-size:13px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;">
                        Epic Free
                      </div>
                      <div style="margin-top:10px;font-size:32px;font-weight:bold;color:#38bdf8;">
                        <%= (epicGames || []).length %>
                      </div>
                    </div>
                  </td>

                  <td width="33.33%" style="padding:8px;">
                    <div style="background:#19233f;border:1px solid #2b3a63;border-radius:14px;padding:18px;text-align:center;">
                      <div style="font-size:13px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;">
                        Steam Free
                      </div>
                      <div style="margin-top:10px;font-size:32px;font-weight:bold;color:#a78bfa;">
                        <%= (steamGames || []).length %>
                      </div>
                    </div>
                  </td>

                  <td width="33.33%" style="padding:8px;">
                    <div style="background:#19233f;border:1px solid #2b3a63;border-radius:14px;padding:18px;text-align:center;">
                      <div style="font-size:13px;color:#94a3b8;text-transform:uppercase;letter-spacing:1px;">
                        Steam Deals
                      </div>
                      <div style="margin-top:10px;font-size:32px;font-weight:bold;color:#4ade80;">
                        <%= deals.length %>
                      </div>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:20px 32px 24px;">
              <h2 style="margin:0 0 20px;font-size:24px;color:#ffffff;">
                Free Games
              </h2>

              <% if (freeGames.length === 0) { %>
                <div style="background:#19233f;border:1px solid #2b3a63;border-radius:18px;padding:28px;text-align:center;">
                  <div style="font-size:34px;line-height:40px;margin-bottom:12px;">🕹️</div>
                  <h3 style="margin:0 0 10px;font-size:24px;color:#ffffff;">
                    No free games found
                  </h3>
                  <p style="margin:0;font-size:15px;line-height:24px;color:#cbd5e1;">
                    No currently free games were found from the configured APIs.
                  </p>
                </div>
              <% } %>

              <% freeGames.forEach((game) => renderCard(game, "Limited-time free game promotion.", "Claim Now")) %>
            </td>
          </tr>

          <tr>
            <td style="padding:0 32px 40px;">
              <h2 style="margin:0 0 20px;font-size:24px;color:#ffffff;">
                Steam Discounts Under <%= safeFormatVnd(steamMaxPriceVnd || 200000) %>
              </h2>

              <% if (deals.length === 0) { %>
                <div style="background:#19233f;border:1px solid #2b3a63;border-radius:18px;padding:28px;text-align:center;">
                  <div style="font-size:34px;line-height:40px;margin-bottom:12px;">💸</div>
                  <h3 style="margin:0 0 10px;font-size:24px;color:#ffffff;">
                    No matching Steam deals found
                  </h3>
                  <p style="margin:0;font-size:15px;line-height:24px;color:#cbd5e1;">
                    No discounted Steam games under your configured price cap were found.
                  </p>
                </div>
              <% } %>

              <% deals.forEach((game) => renderCard(game, "Discounted Steam game under your configured budget.", "View Deal")) %>
            </td>
          </tr>

          <tr>
            <td style="border-top:1px solid #233054;padding:24px 32px;background:#0f172a;text-align:center;">
              <div style="font-size:14px;color:#94a3b8;line-height:24px;">
                Checked at: <%= safeCheckedAt %>
              </div>

              <div style="margin-top:8px;font-size:12px;color:#64748b;line-height:20px;">
                Automated games notifier powered by Steam & Epic APIs.
              </div>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
